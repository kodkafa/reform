{
  "name": "@kodkafa/reform",
  "version": "1.0.1",
  "license": "MIT",
  "description": "",
  "author": "KODKAFA",
  "main": "./dist/reform.umd.js",
  "module": "./dist/reform.es.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/reform.es.js",
      "require": "./dist/reform.umd.js"
    },
    "./reform.css": "./dist/reform.css",
    "./reform.scss": "./dist/reform.scss",
    "./reform.tailwind.css": "./dist/reform.tailwind.css",
    "./reform.tailwind.scss": "./dist/reform.tailwind.scss",
    "./reform.preline.css": "./dist/reform.preline.css",
    "./reform.preline.scss": "./dist/reform.preline.scss",
    "./reform.shadcn.css": "./dist/reform.shadcn.css",
    "./reform.shadcn.scss": "./dist/reform.shadcn.scss"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.50.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kodkafa/reform.git"
  },
  "bugs": {
    "url": "https://github.com/kodkafa/reform/issues"
  },
  "homepage": "https://github.com/kodkafa/reform#readme",
  "keywords": [
    "react",
    "form",
    "reform",
    "react-hook-form",
    "tailwind",
    "shadcn",
    "preline",
    "simple form"
  ],
  "packageManager": "pnpm@7.25.0+",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc && vite build && npm run build:css && npm run copy:css && npm run copy:preline && npm run copy:shadcn",
    "build:css": "tailwindcss -m -i src/tailwind.css -o ./dist/reform.css",
    "copy:css": "npx sass src/styles/reform/reform.scss ./dist/reform.tailwind.css ",
    "copy:preline": "npx sass  src/styles/preline/preline.scss ./dist/reform.preline.css ",
    "copy:shadcn": "npx sass  src/styles/shadcn/reform.scss ./dist/reform.shadcn.css ",
    "build:storybook": "storybook build",
    "storybook": "storybook dev -p 6006",
    "lint": "eslint . --ext ts,tsx --fix",
    "prepare": "husky install"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@chromatic-com/storybook": "^1.8.0",
    "@kodkafa/eslint-config": "^1.1.3",
    "@storybook/addon-essentials": "^8.2.9",
    "@storybook/addon-interactions": "^8.2.9",
    "@storybook/addon-links": "^8.2.9",
    "@storybook/addon-mdx-gfm": "^8.2.9",
    "@storybook/addons": "^7.6.17",
    "@storybook/blocks": "^8.2.9",
    "@storybook/react": "^8.2.9",
    "@storybook/react-vite": "^8.2.9",
    "@storybook/test": "^8.2.9",
    "@tailwindcss/forms": "^0.5.9",
    "@types/node": "^18.19.50",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^3.1.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^7.6.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.35.2",
    "eslint-plugin-storybook": "^0.8.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.3.0",
    "postcss": "^8.4.45",
    "prettier": "^2.8.8",
    "prop-types": "^15.8.1",
    "sass": "^1.78.0",
    "storybook": "^8.2.9",
    "tailwindcss": "^3.4.10",
    "typescript": "^4.9.5",
    "vite": "^4.5.3",
    "vite-plugin-dts": "^1.7.3",
    "vite-plugin-svgr": "^2.4.0",
    "@hookform/resolvers": "^2.9.11",
    "preline": "^1.9.0",
    "yup": "^1.4.0"
  }
}
